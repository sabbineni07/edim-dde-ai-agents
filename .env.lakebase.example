# Lakebase Postgres profile for EDIM DDE AI Agents
#
# Usage:
#   1. Copy values into your .env (or merge with existing .env)
#   2. Set POSTGRES_BACKEND=lakebase
#   3. Authenticate to Databricks workspace (dev): databricks auth login --host https://adb-xxxx.azuredatabricks.net
#   4. Run migrations against Lakebase before starting the API
#
# Discover endpoint path:
#   databricks postgres list-endpoints projects/<project-id>/branches/<branch-id>

USE_POSTGRES=true
POSTGRES_BACKEND=lakebase

# From Lakebase Connect dialog
POSTGRES_HOST=ep-xxxx.databricks.com
POSTGRES_PORT=5432
POSTGRES_USER=your.email@company.com
POSTGRES_DATABASE=databricks_postgres
POSTGRES_SSL_MODE=require

# Required for OAuth token minting (not in the connection string)
POSTGRES_LAKEBASE_ENDPOINT=projects/<project-id>/branches/<branch-id>/endpoints/<endpoint-id>

# Databricks workspace auth for SDK (generate_database_credential)
DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
# Or reuse hostname only:
# DATABRICKS_SERVER_HOSTNAME=adb-xxxx.azuredatabricks.net

# Interactive dev: use `databricks auth login` (no client secret needed)
# CI / Docker / production: service principal OAuth
# DATABRICKS_CLIENT_ID=<service-principal-uuid>
# DATABRICKS_CLIENT_SECRET=<oauth-secret>

# SQL warehouse metrics (unchanged; separate from Lakebase Postgres)
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx
# DATABRICKS_TOKEN=your-databricks-token
# DATABRICKS_JOB_CLUSTER_METRICS_TABLE=your_catalog.your_schema.job_cluster_metrics_aggregated
