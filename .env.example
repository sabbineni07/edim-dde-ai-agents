# EDIM DDE AI Agents - Environment Configuration
# Copy to .env: cp .env.example .env

# Azure AI Foundry / OpenAI v1 (required for real LLM)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# Or: https://YOUR-RESOURCE.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_ACCESS_TOKEN=  # for Azure AD / az login
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search (optional - for RAG)
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
# Optional: omit to use Azure identity (az login / Managed Identity)
# AZURE_SEARCH_API_KEY=your-search-api-key-here
AZURE_SEARCH_INDEX_NAME=recommendations-index

# Vector retrieval for chain RAG: azure_search | faiss | none
# VECTOR_RETRIEVAL_BACKEND=azure_search
# FAISS_INDEX_PATH=/path/to/faiss_index_folder

# Local mode (use sample CSV instead of Databricks)
USE_LOCAL_DATA=true

# YAML config directory (defaults to ./config in repo; in docker-compose it's /app/config)
# CONFIG_DIR=/app/config

# Use mock LLM provider (no Azure OpenAI calls)
# USE_MOCK_LLM=true

# Database
USE_POSTGRES=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=ai_agents

# Admin users (comma-separated) — can edit platform environments in UI
ADMIN_USERNAMES=admin

# Databricks (when USE_LOCAL_DATA=false)
# DATABRICKS_SERVER_HOSTNAME=adb-xxxx.azuredatabricks.net
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxx
# DATABRICKS_TOKEN=your-databricks-token
# DATABRICKS_JOB_CLUSTER_METRICS_TABLE=your_catalog.your_schema.job_cluster_metrics_aggregated
